{application, pgo, [
    {description, "Postgres client with connection pool"},
    {vsn, "git"},
    {registered, []},
    {mod, {pgo_app, []}},
    {applications, [
        kernel,
        stdlib,
        backoff,
        opentelemetry_api,
        pg_types
    ]},
    {env, []},
    {modules, []},

    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/Taure/pgo"},
        {"Upstream", "https://github.com/erleans/pgo"}
    ]}
]}.
